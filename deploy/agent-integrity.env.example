# Server-only protected PKCS8 Ed25519 PEM file. Never place it in an archive.
# Provision through your secret-management process; there is no key upload API.
SAPIENTIA_AGENT_SIGNING_KEY_FILE=/etc/xsera/private/agent-package-signing.pem

# Local Agent installer only. First independently review/export the configured
# signer in the operational console, verify its fingerprint, then provision the
# public trust JSON OUTSIDE the package/installation directory.
SERA_AGENT_TRUSTED_KEYS_FILE=/etc/xsera/trust/agent-package-trust.json
SERA_AGENT_REQUIRE_SIGNED_PACKAGE=1

# Local cryptography Python runtime is required only for pinned Ed25519 mode.
# These are application manifest signatures, not OS code-signing certificates.
